---
interface Props {
	images: string[];
	alt: string;
}

const { images, alt } = Astro.props;

/** Safe JSON for HTML attribute (URLs may contain & etc.) */
const imagesAttr = encodeURIComponent(JSON.stringify(images));
---

{
	images.length === 0 ? null : images.length === 1 ? (
		<div class="project-carousel project-carousel--single">
			<img class="project-carousel__solo" src={images[0]} alt={alt} loading="eager" decoding="async" />
		</div>
	) : (
		<div
			class="project-carousel"
			data-project-carousel
			data-images-encoded={imagesAttr}
			role="region"
			aria-roledescription="carousel"
			aria-label={`${alt} image gallery`}
			tabindex="0"
		>
			<div class="project-carousel__viewport">
				<div class="project-carousel__track">
					<div class="project-carousel__side project-carousel__side--prev">
						<div class="project-carousel__peek project-carousel__peek--prev" aria-hidden="true">
							<img src={images[images.length - 1]} alt="" loading="lazy" decoding="async" data-carousel-img-prev />
						</div>
						<button
							type="button"
							class="project-carousel__arrow project-carousel__arrow--prev"
							aria-label="Previous image"
							data-carousel-prev
						>
							<span aria-hidden="true">‹</span>
						</button>
					</div>
					<div class="project-carousel__main">
						<img src={images[0]} alt={alt} loading="eager" decoding="async" data-carousel-img-main />
					</div>
					<div class="project-carousel__side project-carousel__side--next">
						<div class="project-carousel__peek project-carousel__peek--next" aria-hidden="true">
							<img src={images[1]} alt="" loading="lazy" decoding="async" data-carousel-img-next />
						</div>
						<button
							type="button"
							class="project-carousel__arrow project-carousel__arrow--next"
							aria-label="Next image"
							data-carousel-next
						>
							<span aria-hidden="true">›</span>
						</button>
					</div>
				</div>
			</div>
			<div class="project-carousel__dots" data-carousel-dots role="tablist" aria-label="Slide indicators" />
		</div>
	)
}

<!-- is:inline: runs in-page so carousel init always runs (bundled scripts can fail to attach in SSR) -->
<script is:inline>
	(function () {
		function initCarousel(root) {
			var rawEnc = root.getAttribute('data-images-encoded');
			if (!rawEnc) return;
			var urls;
			try {
				urls = JSON.parse(decodeURIComponent(rawEnc));
			} catch (e) {
				return;
			}
			if (!urls || urls.length < 2) return;

			var i = 0;
			var n = urls.length;

			var imgPrev = root.querySelector('[data-carousel-img-prev]');
			var imgMain = root.querySelector('[data-carousel-img-main]');
			var imgNext = root.querySelector('[data-carousel-img-next]');
			var btnPrev = root.querySelector('[data-carousel-prev]');
			var btnNext = root.querySelector('[data-carousel-next]');
			var dotsEl = root.querySelector('[data-carousel-dots]');

			if (!imgPrev || !imgMain || !imgNext || !btnPrev || !btnNext || !dotsEl) return;

			var dotButtons = [];
			/** Bumps on each slide change; stale async loads are ignored */
			var renderGen = 0;

			function preloadImage(src) {
				return new Promise(function (resolve) {
					if (!src) {
						resolve();
						return;
					}
					var img = new Image();
					img.onload = function () {
						resolve();
					};
					img.onerror = function () {
						resolve();
					};
					img.src = src;
				});
			}

			function render() {
				var gen = ++renderGen;
				var snapshot = i;
				var prevIdx = (snapshot - 1 + n) % n;
				var nextIdx = (snapshot + 1) % n;
				var uPrev = urls[prevIdx];
				var uMain = urls[snapshot];
				var uNext = urls[nextIdx];

				Promise.all([preloadImage(uPrev), preloadImage(uMain), preloadImage(uNext)]).then(function () {
					if (gen !== renderGen) return;
					imgPrev.src = uPrev;
					imgMain.src = uMain;
					imgNext.src = uNext;
					for (var j = 0; j < dotButtons.length; j++) {
						var active = j === snapshot;
						dotButtons[j].classList.toggle('is-active', active);
						dotButtons[j].setAttribute('aria-selected', active ? 'true' : 'false');
					}
				});
			}

			dotsEl.innerHTML = '';
			for (var d = 0; d < n; d++) {
				var b = document.createElement('button');
				b.type = 'button';
				b.className = 'project-carousel__dot';
				b.setAttribute('role', 'tab');
				b.setAttribute('aria-label', 'Go to image ' + (d + 1) + ' of ' + n);
				(function (idx) {
					b.addEventListener('click', function () {
						i = idx;
						render();
					});
				})(d);
				dotsEl.appendChild(b);
				dotButtons.push(b);
			}
			if (dotButtons[0]) dotButtons[0].classList.add('is-active');

			function goPrev() {
				i = (i - 1 + n) % n;
				render();
			}
			function goNext() {
				i = (i + 1) % n;
				render();
			}

			btnPrev.addEventListener('click', function (e) {
				e.preventDefault();
				e.stopPropagation();
				goPrev();
			});
			btnNext.addEventListener('click', function (e) {
				e.preventDefault();
				e.stopPropagation();
				goNext();
			});

			root.addEventListener('keydown', function (e) {
				if (e.key === 'ArrowLeft') {
					e.preventDefault();
					goPrev();
				} else if (e.key === 'ArrowRight') {
					e.preventDefault();
					goNext();
				}
			});

			render();
		}

		function initAll() {
			document.querySelectorAll('[data-project-carousel]').forEach(function (el) {
				initCarousel(el);
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initAll);
		} else {
			initAll();
		}
	})();
</script>

<style>
	/* Bleed width is handled by parent .project-media-bleed (global.css) */
	.project-carousel {
		position: relative;
		margin: 1.75rem 0 2rem;
		width: 100%;
		max-width: 100%;
		min-width: 0;
	}

	.project-carousel--single {
		margin: 1.5rem 0;
	}

	.project-carousel__solo {
		width: 100%;
		max-height: min(78vh, 640px);
		object-fit: contain;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}

	/* No extra panel background; clip any stray overflow */
	.project-carousel__viewport {
		overflow-x: clip;
		overflow-y: visible;
		border-radius: 0;
		background: transparent;
		width: 100%;
		min-width: 0;
	}

	.project-carousel__track {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.35fr) minmax(0, 0.95fr);
		gap: 0.5rem;
		align-items: stretch;
		min-height: min(72vh, 560px);
		width: 100%;
		min-width: 0;
	}

	.project-carousel__side {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: min(68vh, 520px);
		min-width: 0;
	}

	/* Side peeks: soft fade via overlay (avoids mask fringe on page background) */
	.project-carousel__peek {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-radius: 10px;
		pointer-events: none;
		z-index: 0;
		background: rgb(var(--gray-light));
	}

	.project-carousel__peek--prev img,
	.project-carousel__peek--next img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		opacity: 0.55;
	}

	.project-carousel__peek--prev::after,
	.project-carousel__peek--next::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		border-radius: 10px;
	}

	.project-carousel__peek--prev::after {
		background: linear-gradient(
			to right,
			rgba(255, 255, 255, 0.92) 0%,
			rgba(255, 255, 255, 0.35) 38%,
			transparent 72%
		);
	}

	.project-carousel__peek--next::after {
		background: linear-gradient(
			to left,
			rgba(255, 255, 255, 0.92) 0%,
			rgba(255, 255, 255, 0.35) 38%,
			transparent 72%
		);
	}

	.project-carousel__main {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
		min-height: min(68vh, 520px);
		min-width: 0;
		background: transparent;
	}

	.project-carousel__main img {
		width: 100%;
		height: auto;
		max-width: 100%;
		max-height: min(72vh, 600px);
		object-fit: contain;
		display: block;
	}

	/* Arrows on side columns — high contrast so they show on any photo */
	.project-carousel__arrow {
		position: absolute;
		z-index: 10;
		top: 50%;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid rgba(var(--black), 0.18);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.94);
		color: rgb(var(--black));
		font-size: 1.85rem;
		line-height: 1;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition:
			background 0.2s ease,
			box-shadow 0.2s ease;
		box-shadow: 0 2px 10px rgba(var(--black), 0.18);
	}

	.project-carousel__arrow:hover {
		background: #fff;
		box-shadow: 0 3px 14px rgba(var(--black), 0.22);
	}

	.project-carousel__arrow--prev {
		left: 50%;
		transform: translate(-50%, -50%);
	}

	.project-carousel__arrow--next {
		left: 50%;
		transform: translate(-50%, -50%);
	}

	.project-carousel__dots {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.55rem;
		flex-wrap: wrap;
		padding: 0.85rem 0 0.25rem;
		min-height: 1.5rem;
		width: 100%;
		box-sizing: border-box;
	}

	/*
	 * Dots are created in JS — they don't get Astro's scoped attribute.
	 * :global(...) is required or styles never apply (default = empty oval buttons).
	 */
	.project-carousel :global(.project-carousel__dot) {
		appearance: none;
		-webkit-appearance: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 10px;
		height: 10px;
		min-width: 10px;
		min-height: 10px;
		padding: 0;
		margin: 0;
		border: 2px solid rgba(var(--gray-dark), 0.45);
		border-radius: 50%;
		box-sizing: border-box;
		background: rgba(var(--gray-dark), 0.35);
		cursor: pointer;
		flex: 0 0 auto;
		transition:
			width 0.2s ease,
			height 0.2s ease,
			min-width 0.2s ease,
			min-height 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.project-carousel :global(.project-carousel__dot.is-active) {
		width: 14px;
		height: 14px;
		min-width: 14px;
		min-height: 14px;
		background: var(--accent);
		border-color: var(--accent-dark);
		box-shadow: 0 0 0 2px rgba(35, 55, 255, 0.28);
		transform: scale(1.05);
	}

	@media (max-width: 720px) {
		.project-carousel__track {
			grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.2fr) minmax(0, 0.82fr);
			gap: 0.3rem;
			min-height: min(58vh, 420px);
		}

		.project-carousel__side {
			min-height: min(52vh, 380px);
		}

		.project-carousel__main {
			min-height: min(52vh, 380px);
		}

		.project-carousel__arrow {
			width: 2.35rem;
			height: 2.35rem;
			font-size: 1.55rem;
		}
	}
</style>
